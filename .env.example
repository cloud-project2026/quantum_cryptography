# Environment Configuration for PQC Migration Platform

# Flask environment: 'development' or 'production'
ENV=development

# Server listening port
PORT=5000

# Secret key for session management and CSRF protection
SECRET_KEY=change-this-to-a-secure-random-value-in-production

# SQLite database file path
DATABASE_PATH=results/experiments.db

# Automatically start built-in TLS 1.3 loopback server on 127.0.0.1:54443
START_LOOPBACK_SERVER=true

# SSRF Protection: Comma-separated list of allowed hostnames/IPs for benchmarking
ALLOWED_BENCHMARK_HOSTS=localhost,127.0.0.1,httpbin.org,example.com

# Benchmark constraints
MAX_REPETITIONS=200
MAX_CONCURRENCY=20
DEFAULT_TIMEOUT=10.0
